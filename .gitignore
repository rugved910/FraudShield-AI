# Raw data — the credit card dataset must NOT be committed (Kaggle licence, 150 MB)
data/raw/
data/processed/

# Large generated artifacts (trained models) are regenerated by training and
# are not committed. The small JSON metric files ARE committed so the dashboard
# works out of the box without re-training.
artifacts/*.joblib
artifacts/*.pkl

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Matplotlib / notebook checkpoints
.ipynb_checkpoints/
